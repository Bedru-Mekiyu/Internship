{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ./vite.config.mjs",
    "build": "tsc -b && vite build --config ./vite.config.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview --config ./vite.config.mjs",
    "test": "vitest run --config ./vitest.config.mjs",
    "test:watch": "vitest --config ./vitest.config.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
