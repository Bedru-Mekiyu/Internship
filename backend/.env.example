NODE_ENV=development
PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/mit_lms

# Auto-start in-memory MongoDB in local dev when local Mongo isn't running.
# Only used when NODE_ENV !== 'production' and AUTO_START_INMEMORY_MONGO !== 'false'
AUTO_START_INMEMORY_MONGO=false
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAME_SITE=lax
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_VERIFY_SECRET=replace_with_verify_secret
JWT_RESET_SECRET=replace_with_reset_secret
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1
EMAIL_USER=replace_with_email_user
EMAIL_PASS=replace_with_email_password
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret
BANK_TRANSFER_AUTO_COMPLETE=false
MAX_UPLOAD_SIZE_MB=250

# Optional: Redis URL for distributed rate limiting, cache, Socket.IO adapter, BullMQ
# REDIS_URL=redis://localhost:6379

# Published course catalog cache (seconds). Requires REDIS_URL. Disable with DISABLE_COURSE_LIST_CACHE=true
# CACHE_COURSE_LIST_TTL_SEC=45

# Optional: global API ceiling (requests per window per IP). 0 = disabled (default).
# GLOBAL_API_RATE_LIMIT_MAX=600
# GLOBAL_API_RATE_LIMIT_WINDOW_MS=900000

# Prometheus /metrics — set bearer to avoid public scraping
# METRICS_BEARER_TOKEN=

# Async jobs (email, etc.) — requires REDIS_URL
# ENABLE_JOB_QUEUE=false

# Stripe credentials are required for real card checkout
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

# PayPal credentials are required for real PayPal checkout
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:3000/payments/success
PAYPAL_CANCEL_URL=http://localhost:3000/payments/cancel
PAYPAL_CAPTURE_ON_CONFIRM=true
