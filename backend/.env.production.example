NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongo:27017/mit_lms
CORS_ORIGIN=https://your-frontend-domain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAME_SITE=lax
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_VERIFY_SECRET=replace_with_strong_verify_secret
JWT_RESET_SECRET=replace_with_strong_reset_secret
BASE_URL=https://your-backend-domain.com
FRONTEND_URL=https://your-frontend-domain.com
# Behind a reverse proxy (nginx, load balancer), Express should trust X-Forwarded-* headers.
TRUST_PROXY=1
# SMTP (use app secrets store in real deployments — never commit real credentials)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_smtp_user
EMAIL_PASS=replace_with_smtp_password
PAYMENT_WEBHOOK_SECRET=replace_with_strong_webhook_secret
BANK_TRANSFER_AUTO_COMPLETE=false

# Stripe credentials are required for real card checkout
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_SUCCESS_URL=https://your-frontend-domain.com/payments/success
STRIPE_CANCEL_URL=https://your-frontend-domain.com/payments/cancel

# PayPal credentials are required for real PayPal checkout
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_RETURN_URL=https://your-frontend-domain.com/payments/success
PAYPAL_CANCEL_URL=https://your-frontend-domain.com/payments/cancel
PAYPAL_CAPTURE_ON_CONFIRM=true
